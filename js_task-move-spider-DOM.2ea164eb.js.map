'use strict';
var wall = document.querySelector('.wall');
var spider = document.querySelector('.spider');
wall.addEventListener('click', function(e) {
    var x = e.clientX;
    var y = e.clientY;
    var wallRect = wall.getBoundingClientRect();
    var insideX = x - wallRect.left;
    var insideY = y - wallRect.top;
    var spiderWidth = spider.offsetWidth;
    var spiderHeight = spider.offsetHeight;
    var spiderX = insideX - spiderWidth / 2;
    var spiderY = insideY - spiderHeight / 2;
    spiderX = Math.min(Math.max(spiderX, 0), wall.clientWidth - spiderWidth);
    spiderY = Math.min(Math.max(spiderY, 0), wall.clientHeight - spiderHeight);
    spider.style.left = spiderX + 'px';
    spider.style.top = spiderY + 'px';
});

